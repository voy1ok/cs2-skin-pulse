# Расписание сборщика CS2 Skin Pulse. vps-run.sh сам ставит этот файл в /etc/cron.d/skinpulse.
# Рынок Skinport собирает GitHub Actions (.github/workflows/update.yml): с этого VPS Skinport не пускает (Cloudflare 403).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/30 * * * * root flock -n /run/skinpulse.lock /opt/skinpulse/app/scripts/vps-run.sh >> /var/log/skinpulse.log 2>&1
17 0 * * *   root flock -w 1800 /run/skinpulse.lock /opt/skinpulse/app/scripts/vps-run.sh --daily >> /var/log/skinpulse.log 2>&1
